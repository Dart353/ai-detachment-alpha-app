{
  "name": "ai-detachment-alpha",
  "productName": "AI Detachment Alpha",
  "version": "1.5.0",
  "description": "A minimal Electron terminal multiplexer for Claude Code",
  "main": "./out/main/index.js",
  "private": true,
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "dev": "node scripts/electron-vite.mjs dev",
    "build": "node scripts/electron-vite.mjs build",
    "start": "node scripts/electron-vite.mjs preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "pnpm build && node scripts/e2e-smoke.mjs",
    "make:icon": "node scripts/make-icon.mjs",
    "package:dir": "pnpm build && node scripts/package.mjs linux dir",
    "package:linux": "pnpm build && node scripts/package.mjs linux",
    "package:win": "pnpm build && node scripts/package.mjs win",
    "package:mac": "pnpm build && node scripts/package.mjs mac",
    "postinstall": "electron-rebuild -f -w node-pty"
  },
  "build": {
    "appId": "io.dart353.ai-detachment-alpha",
    "productName": "AI Detachment Alpha",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/node-pty/**"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "executableName": "ai-detachment-alpha",
      "category": "Development",
      "target": [
        "AppImage",
        "dir"
      ]
    }
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.2.5",
    "@headless-tree/core": "^1.7.0",
    "@headless-tree/react": "^1.7.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "lucide-react": "^1.23.0",
    "node-pty": "^1.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "socket.io-client": "^4.8.3",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.1.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^37.0.0",
    "electron-builder": "^26.16.1",
    "electron-vite": "^3.0.0",
    "socket.io": "^4.8.3",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
